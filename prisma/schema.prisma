// Spanlyfy data model — see docs/implementation/01-data-model-prisma.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────
enum Platform {
  facebook
  instagram
  linkedin
  threads
  tiktok
  youtube
  x
}

enum AccountStatus {
  active
  expired
  error
}

enum PostType {
  text
  image
  video
  story
}

enum PostStatus {
  draft
  scheduled
  publishing
  posted
  failed
  canceled
  removed
}

enum ScheduleMode {
  now
  time
  queue
}

enum TargetStatus {
  pending
  publishing
  success
  failed
  canceled
}

enum MediaKind {
  image
  video
  pdf
}

enum BillingInterval {
  month
  year
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  paused
  canceled
}

enum IgConnectMethod {
  instagram
  facebook
}

// Refund-request workflow (doc 17). The customer "Request Refund" route records a
// `pending` row; staff approve (issuing a Stripe refund in live mode) or deny it.
enum RefundStatus {
  pending
  approved
  denied
  refunded
}

// Staff access tiers (doc 15). `user` is a normal customer; support/admin/superadmin
// are staff. Role gating lives in src/server/admin/access.ts (never on the client).
enum Role {
  user
  support
  admin
  superadmin
}

// ─────────────────────────── Core ────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Null for OAuth-only accounts (e.g. Google sign-in) that never set a password.
  passwordHash  String?
  // Google `sub` (stable account id) when the user has linked Google sign-in (doc: google oauth).
  googleId      String?   @unique
  displayName   String?
  avatarUrl     String?
  timezone      String    @default("UTC")
  emailVerified DateTime?

  // Staff role + suspension (doc 15). All existing rows default to `user`.
  role        Role      @default(user)
  suspendedAt DateTime?

  // Marketing/newsletter opt-in (CAN-SPAM/GDPR). Defaults true; cleared by one-click unsubscribe
  // or the account settings toggle. Newsletter sends filter on this column.
  marketingEmails Boolean @default(true)

  // settings (doc 11A): email + platform prefs, weekly goal, mcp
  settings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription  Subscription?
  accounts      SocialAccount[]
  posts         Post[]
  media         Media[]
  queueSettings QueueSettings?
  sessions      Session[]
  apiKeys       ApiKey[]
  webhook       WebhookEndpoint?
  auditLogs     AuditLog[]      @relation("AuditActor")
  supportNotes  SupportNote[]   @relation("NoteSubject")
  authoredNotes SupportNote[]   @relation("NoteAuthor")
  refundRequests RefundRequest[]
  moderatedPosts Post[]          @relation("PostModerator")
  loginOtps      LoginOtp[]
  trustedDevices TrustedDevice[]
}

// Short-lived numeric login codes for step-up auth on a new device (D-013). We store only a
// SHA-256 of the 6-digit code, cap attempts to blunt brute force, and mark `consumedAt` on use.
// 10-min TTL. Distinct from VerificationToken (those are long single-use link tokens).
model LoginOtp {
  id        String    @id @default(cuid())
  userId    String
  // What the code is for: 'login' (new-device step-up) | 'verify_email' (confirm address). Scopes
  // issue/verify so a code minted for one purpose can never satisfy the other.
  purpose   String    @default("login")
  codeHash  String // sha256(6-digit code)
  expiresAt DateTime
  attempts  Int       @default(0)
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

// A device the user has cleared via OTP. The browser holds an opaque token in a long-lived cookie;
// we store its SHA-256 here. A matching, unexpired row lets that device skip OTP for 30 days.
// Deleting rows = "this device must verify again". Mirrors the Session hashing pattern.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // sha256(device token)
  userAgent  String?
  ip         String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Actionable refund queue (doc 17). Created by the customer refund route (in-policy) or
// staff-initiated. `amount` is minor units (cents); `decidedById` is the staff user id
// (no relation — keep it simple). `stripeRefundId` set only when a live refund is issued.
model RefundRequest {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  amount         Int // minor units (cents)
  reason         String
  status         RefundStatus @default(pending)
  providerRefundId String? // PayPal refund id
  decidedById    String? // staff user id (no relation, keep it simple)
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

// Free-form staff note attached to a customer account (doc 16). Shown on the user
// detail Activity tab alongside the AuditLog. `author` is the staff member who wrote it.
model SupportNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Append-only admin action log (doc 15). Written by logAdminAction() after every
// successful mutating /api/admin/* call. metadata holds before/after, reasons,
// amounts — never secrets, tokens, or password hashes.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String // e.g. "user.suspend", "refund.approve", "user.impersonate"
  targetType String? // "user" | "subscription" | "post" | "account" | ...
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// Programmatic-access API key (doc 12). We store only a SHA-256 hash of the secret plus a
// non-secret prefix + last-4 for display; the plaintext is shown exactly once at creation.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String // non-secret, e.g. "spb_live" (shown in the list)
  last4      String // last 4 chars of the secret, for identification
  hashedKey  String    @unique // sha256(secret)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-user webhook endpoint (doc 12). Post-completion callbacks are signed with HMAC-SHA256
// over the request body using `secret`.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String   @unique
  url       String
  secret    String // HMAC signing secret (generated server-side)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Lightweight log of inbound Stripe webhooks + outbound user-webhook deliveries (doc 19).
// Written best-effort by the existing handlers; read by the admin event log. Holds only
// event metadata — never tokens, secrets, or signatures.
model WebhookEvent {
  id        String   @id @default(cuid())
  source    String // "stripe" | "user_webhook"
  type      String
  status    String // received | processed | failed | delivered
  refId     String? // stripe event id / post id
  attempts  Int      @default(1)
  error     String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// Platform settings & feature flags (doc 20). A DB-backed kill-switch / config store
// read by both the admin UI and the customer app gates. A MISSING row defaults to
// enabled (see src/server/settings/flags.ts) so an absent flag never blocks the product.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  value       Json?
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// DB-backed plan catalog (was the hardcoded PlanKey enum + src/server/plans.ts data).
// Admin-editable so tiers can be added/removed. `key` is the dynamic plan key referenced
// by Subscription.plan (no FK — app-level integrity). accountLimit -1 = unlimited.
model Plan {
  key          String   @id
  name         String
  tagline      String   @default("")
  monthly      Int // whole dollars (matches 29/49/99)
  yearly       Int
  accountLimit Int // -1 = unlimited
  features     String[]
  rank         Int // tier ordering + comparison (was PLAN_RANK)
  isPublic     Boolean  @default(true) // shown on pricing/checkout
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, rank])
}

// Platform-wide config defaults store (trial length, refund window, signups default).
// Read via src/server/settings/config.ts with the same cache+fallback pattern as flags.
model PlatformConfig {
  key       String   @id // "trialDays" | "refundWindowDays" | "signupsDefault"
  value     Json
  updatedAt DateTime @updatedAt
}

// Customer-facing announcement banners (doc 20). Audience + active-window filtered by
// activeAnnouncements(user). `severity`: info | warning | critical.
// `audience`: all | trialing | plan:<key>.
model Announcement {
  id          String    @id @default(cuid())
  message     String
  severity    String    @default("info")
  audience    String    @default("all")
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([active, startsAt])
}

// Public waitlist sign-ups (doc 20 waitlist mode). Collected from the landing page while the
// site is in waitlist mode; `email` is stored normalized (lowercase, trimmed) and unique so a
// re-submit is idempotent. `position` is derived from createdAt ordering, not stored.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  ip        String?
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Auth.js session table (Credentials + DB sessions). Deleting rows powers
// "sign out of all devices".
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // Staff user id when this session is an impersonation (doc 21). No relation — kept a
  // bare id like decidedById elsewhere. Null on normal sessions.
  impersonatorId String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  plan             String             @default("creator") // dynamic plan key (was PlanKey enum); app-level integrity, no FK
  interval         BillingInterval    @default(month)
  status           SubscriptionStatus @default(trialing)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd  Boolean            @default(false) // scheduled to cancel at period end; access persists until then
  apiAddonActive     Boolean            @default(false)
  providerCustomerId String? // Polar customer id (when known); identity carried by external_customer_id
  providerSubId      String? // Polar subscription id
  providerAddonSubId String? // separate Polar subscription id for the $5/mo API add-on
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id              String           @id @default(cuid())
  userId          String
  platform        Platform
  handle          String // @name shown on chips
  displayName     String?
  avatarUrl       String?
  externalId      String // provider's user/page id
  pageId          String? // Meta Page id when applicable
  igConnectMethod IgConnectMethod?
  status          AccountStatus    @default(active)
  capabilities    String[] // ['text','image','video','story']
  scopes          String[]
  encryptedTokens String // AES-256-GCM blob (access+refresh+expiry)
  tokenExpiresAt  DateTime?
  connectedAt     DateTime         @default(now())
  disconnectedAt  DateTime? // soft-delete (D-010) — preserve post history
  updatedAt       DateTime         @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets PostTarget[]

  @@unique([userId, platform, externalId])
  @@index([userId, platform])
}

model Post {
  id           String       @id @default(cuid())
  userId       String
  type         PostType
  mainCaption  String       @default("")
  // map socialAccountId -> caption override (doc 06)
  perPlatform  Json         @default("{}")
  status       PostStatus   @default(draft)
  scheduleMode ScheduleMode @default(now)
  publishAt    DateTime? // UTC; null for now/draft
  timezone     String       @default("UTC")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  publishedAt  DateTime?
  // Set once the post-completion webhook has been delivered (doc 12) — idempotent under retries.
  webhookSentAt DateTime?

  // Staff moderation overlay (doc 18): who canceled/took down this post and why.
  moderatedById    String?
  moderatedAt      DateTime?
  moderationReason String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy User?        @relation("PostModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  targets     PostTarget[]
  media       PostMedia[]

  @@index([userId, status])
  @@index([status, publishAt]) // scheduler "due posts" query
}

model PostTarget {
  id              String       @id @default(cuid())
  postId          String
  socialAccountId String
  status          TargetStatus @default(pending)
  caption         String // resolved caption used for THIS account
  externalPostId  String?
  externalUrl     String?
  error           String?
  attempts        Int          @default(0)
  // idempotency key so retries never double-post (doc 08)
  idempotencyKey  String       @unique
  publishedAt     DateTime?

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
}

model Media {
  id           String      @id @default(cuid())
  userId       String
  kind         MediaKind
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  durationSec  Float?
  sizeBytes    Int?
  mimeType     String?
  processed    Boolean     @default(false) // server-side re-encode done
  createdAt    DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts PostMedia[]

  @@index([userId])
}

model PostMedia {
  postId  String
  mediaId String
  order   Int

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@index([postId])
}

// Queue (doc 11B): slots that "Add to queue" fills.
model QueueSettings {
  id                     String      @id @default(cuid())
  userId                 String      @unique
  timezone               String      @default("UTC")
  randomizeWithinMinutes Int         @default(0)
  slots                  QueueSlot[]
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QueueSlot {
  id         String        @id @default(cuid())
  settingsId String
  time       String // "HH:mm" 24h
  days       Boolean[] // length 7, Mon..Sun
  settings   QueueSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId])
}

// Single-use tokens for email verification + password reset (doc 03).
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // 'verify_email' | 'reset_password'
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}
